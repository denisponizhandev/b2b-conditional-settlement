# RPC (used by forge CLI, not read inside scripts)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Wallet that signs deploy / createDeal txs (no 0x prefix)
PRIVATE_KEY=

# --- Deploy.s.sol (optional; default = deployer address) ---
FACTORY_ADMIN=
DEAL_CREATOR=

# --- CreateDeal.s.sol (required after deploy) ---
ESCROW_FACTORY_ADDRESS=
MOCK_TOKEN_ADDRESS=
DEAL_INTENT_ID=

# Deal participants (approver / payer / payee required)
DEAL_ADMIN=
DEAL_APPROVER=
DEAL_PAYER=
DEAL_PAYEE=

# Optional demo amounts (6 decimals: 1_000_000 = 1 USDC)
RETENTION_BPS=0
MILESTONE_0=500000
MILESTONE_1=300000
MINT_AMOUNT=800000
